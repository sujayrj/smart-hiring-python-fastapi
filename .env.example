# Copy to .env and adjust. Never commit real keys.

# mock | openai | anthropic  (mock runs fully offline)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# Auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=480

# Persistence (in-memory SQLite)
DATABASE_URL=sqlite://

# Seed data location (relative to backend/)
INPUT_DATA_PATH=../input-data.json

# Fusion policy
HOLD_MARGIN=15
QA_MAX_SCORE=5
